POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=
# Used only when running `npm run test` (see vitest.config.ts). Must point
# to a separate database (e.g. same host/credentials as DATABASE_URL, but
# a different database name) so the test suite never touches dev data.
TEST_DATABASE_URL=
JWT_SECRET=
PORT=3000

# Used only by `npm run prisma:seed` to create/update the admin user.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
